
ELASTIC_API_KEY=
ES_USERNAME=elastic-admin
ES_PASSWORD=elastic-password

# ─────────────────────────────────────────────────────────────────────────────
# Exemplars
# ─────────────────────────────────────────────────────────────────────────────
# trace_based (spec default): a measurement becomes an exemplar candidate only
#   when recorded under a sampled span. Production-correct.
# always_on: record exemplars regardless of sampling. Useful to prove exemplars
#   flow when you have sampling turned down.
# always_off: no exemplars, for a control run.
OTEL_METRICS_EXEMPLAR_FILTER=trace_based

# Trace sampling ratio. Under trace_based, this is also the exemplar volume
# control -- drop it to 0.1 to see exemplars thin out.
TRACE_SAMPLE_RATIO=1.0

# ─────────────────────────────────────────────────────────────────────────────
# Export timing
# ─────────────────────────────────────────────────────────────────────────────
# Milliseconds between metric exports. Shorter intervals mean more exemplars
# reach Elasticsearch per unit time and fewer duplicate-timestamp collisions
# per export; longer intervals do the opposite.
OTEL_METRIC_EXPORT_INTERVAL=10000

# ─────────────────────────────────────────────────────────────────────────────
# Load generator
# ─────────────────────────────────────────────────────────────────────────────
K6_VUS=10
K6_DURATION=30m

# ─────────────────────────────────────────────────────────────────────────────
# Service behaviour
# ─────────────────────────────────────────────────────────────────────────────
# How often the inventory ledger releases reservations, and how many units per
# SKU. Lower units or longer intervals mean more genuine 409s.
RESTOCK_INTERVAL_SECONDS=20
RESTOCK_UNITS_PER_SKU=25

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────
CHECKOUT_PORT=8000
INVENTORY_PORT=8001
GRAFANA_PORT=3000

DEPLOYMENT_ENVIRONMENT=local
